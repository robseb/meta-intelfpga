# short-description: Create SD card image for Cyclone V SoC FPGA emulator
# long-description: Creates a partitioned SD card image for the Cyclone V SoC FPGA emulator.
# Boot files are located in the first vfat partition.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4 --size 16
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4