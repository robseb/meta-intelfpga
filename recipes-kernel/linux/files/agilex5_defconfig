# Agilex5 default kernel configuration with DynamIQ support
# This is the base defconfig for Agilex5 hardware with ARM DynamIQ

# Architecture and CPU
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PA_BITS_48=y

# SMP and DynamIQ features
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
CONFIG_ARM64_LSE_ATOMICS=y

# Platform support
CONFIG_ARCH_SOCFPGA=y
CONFIG_ARCH_STRATIX10=y
CONFIG_ARCH_AGILEX=y

# Memory management
CONFIG_ARM64_DMA_USE_COHERENT_HELPERS=y
CONFIG_ZONE_DMA=y
CONFIG_ZONE_DMA32=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_COMPACTION=y

# Platform devices
CONFIG_ARM_AMBA=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_ARM_PSCI=y

# Timers
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y

# Power management and DynamIQ CPU scaling
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_PM_RUNTIME=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOVERNOR_PERFORMANCE=y
CONFIG_CPU_FREQ_GOVERNOR_ONDEMAND=y
CONFIG_CPU_FREQ_GOVERNOR_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_SCPI_CPUFREQ=y

# CPU idle
CONFIG_CPU_IDLE=y
CONFIG_ARM_CPUIDLE=y

# Thermal management for big.LITTLE
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y

# NUMA for multi-cluster
CONFIG_NUMA=y

# Performance monitoring
CONFIG_ARM_PMU=y
CONFIG_ARM_SPE_PMU=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y

# Device drivers
CONFIG_BLOCK=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_GENERIC=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y

# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# MMC/SD support
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_DW=y

# I2C support
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y

# SPI support
CONFIG_SPI=y
CONFIG_SPI_DESIGNWARE=y

# GPIO support
CONFIG_GPIOLIB=y
CONFIG_GPIO_DWAPB=y

# Ethernet
CONFIG_NETDEVICES=y
CONFIG_NET_ETHERNET=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y

# USB support
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Kernel features
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=14
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Module support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y